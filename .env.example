# ====================================================================
# AI Interview Preparation Platform - Environment Variables
# Copy this file to .env or export these in your operating system
# ====================================================================

# Server Port
PORT=8080

# Spring Active Profile: 'mysql' for MySQL production/dev, 'h2' for embedded zero-config mode
SPRING_PROFILES_ACTIVE=mysql

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_interview_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security
# Ensure this is a secure 256-bit or 512-bit hex/base64 secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AI Evaluation Service Provider ('gemini' or 'openai')
AI_PROVIDER=gemini

# Google Gemini API Configuration (Leave blank to use intelligent offline heuristic engine)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# OpenAI API Configuration (Optional alternative provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
